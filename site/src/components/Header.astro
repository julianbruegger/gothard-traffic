---
import { t, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';
import { lookupPath, routePath } from '../lib/routes';

interface Props {
  lang: Lang;
  /** Highlighted nav item; null for pages that are not in the main nav (guides). */
  currentPage?: 'status' | 'forecasts' | 'statistics' | 'nerd' | null;
}
const { lang, currentPage = 'status' } = Astro.props;

// The DE/EN switch points at the same page in the other language, looked up in
// the route map (slugs differ per language, e.g. /sperrungen ↔ /en/closures).
const route = lookupPath(Astro.url.pathname);
const langHref = (l: Lang) => routePath(route?.key ?? 'home', l);
const deHref = langHref('de');
const enHref = langHref('en');
const home = (l: Lang) => routePath('home', l);

const links = [
  { key: 'status', href: home(lang), label: t(lang, 'nav.live'), icon: 'live' },
  { key: 'forecasts', href: routePath('forecasts', lang), label: t(lang, 'nav.forecast'), icon: 'calendar' },
  { key: 'statistics', href: routePath('statistics', lang), label: t(lang, 'nav.stats'), icon: 'bar_chart' },
  { key: 'nerd', href: routePath('nerd', lang), label: t(lang, 'nav.nerd'), icon: 'table' },
] as const;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__brand" href={home(lang)}>
      <span class="site-header__mark"><Icon name="terrain" size={24} /></span>
      <span>{t(lang, 'site.title')}</span>
    </a>
    <nav class="site-nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      {links.map((l) => (
        <a href={l.href} class="site-nav__link" aria-current={currentPage === l.key ? 'page' : undefined}>
          <Icon name={l.icon} size={20} />{l.label}
        </a>
      ))}
    </nav>
    <div class="header__actions">
      <nav class="lang-switch" aria-label={lang === 'de' ? 'Sprache' : 'Language'}>
        <a href={deHref} lang="de" aria-current={lang === 'de' ? 'true' : 'false'} data-lang-link="de">DE</a>
        <a href={enHref} lang="en" aria-current={lang === 'en' ? 'true' : 'false'} data-lang-link="en">EN</a>
      </nav>
      <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label={t(lang, 'theme.toggle')}>
        <Icon name="moon" size={22} class="icon theme-toggle__moon" />
        <Icon name="sun" size={22} class="icon theme-toggle__sun" />
      </button>
    </div>
  </div>
</header>
