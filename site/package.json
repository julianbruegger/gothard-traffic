{
  "name": "gotthard-traffic-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/csp-hashes.mjs",
    "build:fast": "astro build && node scripts/csp-hashes.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:seo": "node scripts/check-seo.mjs",
    "fetch": "node scripts/fetch-data.mjs",
    "fetch:watch": "node scripts/fetch-data.mjs --watch",
    "build:profiles": "node scripts/build-empirical-profiles.mjs",
    "build:historic-days": "node scripts/build-historic-days.mjs",
    "build:observed": "node scripts/build-observed-days.mjs",
    "backtest": "esbuild scripts/backtest-forecast.ts --bundle --platform=node --format=esm --outfile=.astro/backtest.mjs --log-level=error && node .astro/backtest.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  }
}
