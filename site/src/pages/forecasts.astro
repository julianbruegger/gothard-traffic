---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ForecastsContent from '../components/ForecastsContent.astro';

const lang = 'de' as const;
---

<Layout lang={lang} updatedIso={null}>
  <Header lang={lang} currentPage="forecasts" />
  <ForecastsContent lang={lang} />
  <Footer lang={lang} dataSource="Verkehrsmodell (ASTRA-Daten)" />
</Layout>
