---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NerdContent from '../components/NerdContent.astro';
import { DEFAULT_LANG } from '../lib/i18n';

const lang = DEFAULT_LANG;
---

<Layout lang={lang} updatedIso={null}>
  <Header lang={lang} currentPage="nerd" />
  <main id="main">
    <NerdContent lang={lang} />
  </main>
  <Footer lang={lang} dataSource="ASTRA" />
</Layout>
