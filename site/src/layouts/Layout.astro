---
import '../styles/global.css';
import { DEFAULT_LANG, t, type Lang } from '../lib/i18n';
import { ROUTES, HREFLANG, X_DEFAULT_LANG, alternates, lookupPath, routePath } from '../lib/routes';

interface Props {
  lang?: Lang;
  updatedIso?: string | null;
  /** Per-page <title>; defaults to the home title. */
  title?: string;
  /** Per-page meta description; defaults to the home description. */
  description?: string;
  /** 'dataset' (home, default) emits the live Dataset JSON-LD; 'webpage' emits WebPage + BreadcrumbList. */
  schema?: 'dataset' | 'webpage';
  /** Name of this page in the BreadcrumbList; defaults to the title before " – ". */
  breadcrumb?: string;
  /** Extra JSON-LD blocks for this page (FAQPage, Dataset, …), one <script> each. */
  jsonLd?: Record<string, unknown>[];
}

const {
  lang = DEFAULT_LANG,
  updatedIso = null,
  title: titleProp,
  description: descriptionProp,
  schema = 'dataset',
  breadcrumb,
  jsonLd = [],
} = Astro.props;

const title = titleProp ?? `${t(lang, 'site.title')} – ${t(lang, 'site.tagline')}`;
const description = descriptionProp ?? t(lang, 'meta.description');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Canonical + hreflang come from the route map (lib/routes.ts): each language
// lives at its own real URL and slugs are translated (/sperrungen ↔
// /en/closures), so the alternates are looked up, not derived from the path.
const route = lookupPath(Astro.url.pathname);
if (!route) throw new Error(`Layout: ${Astro.url.pathname} is not in ROUTES (src/lib/routes.ts)`);
const abs = (path: string) => siteUrl + path;
const canonical = abs(routePath(route.key, lang));
const hreflangs = alternates(route.key).map(([l, path]) => ({ hreflang: HREFLANG[l], href: abs(path) }));
const xDefault = ROUTES[route.key][X_DEFAULT_LANG];
const homeHref = abs(routePath('home', lang));
const webPageLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      description,
      inLanguage: lang === 'de' ? 'de-CH' : 'en',
      isPartOf: { '@type': 'WebSite', name: t(lang, 'site.title'), url: homeHref },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t(lang, 'site.title'), item: homeHref },
        { '@type': 'ListItem', position: 2, name: breadcrumb ?? title.split(' – ')[0], item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply the saved theme before first paint to avoid a flash of the wrong palette. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('gt-dashboard-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#eceef4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2024" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gotthard Traffic Live" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- JSON-LD structured data: replaced server-side (index.php) with live values on deploy;
         this default block keeps the page valid/self-describing when served as plain static HTML. -->
    {schema === 'dataset' ? <script type="application/ld+json" id="ld-traffic" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Gotthard Tunnel & Pass Traffic Status',
      description,
      url: canonical,
      dateModified: updatedIso ?? undefined,
      creator: {
        '@type': 'Organization',
        name: 'Gotthard Traffic Live',
        url: siteUrl,
      },
      isBasedOn: {
        '@type': 'Dataset',
        name: 'ASTRA / opentransportdata.swiss Traffic Situations',
        url: 'https://opentransportdata.swiss/en/road-traffic/',
      },
      variableMeasured: ['queue length (km)', 'waiting time (min)', 'road status'],
      distribution: [
        { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: siteUrl + '/api/gotthard.php' },
        { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: siteUrl + '/api/history.php' },
      ],
    })} /> : <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageLd)} />}
    {jsonLd.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)}

    <!-- Site-level identity for search engines, in the current page language. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: t(lang, 'site.title'),
      url: siteUrl + '/',
      inLanguage: lang === 'de' ? 'de-CH' : 'en',
      description: t(lang, 'meta.description'),
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <slot />
    <!-- Theme toggle: flips data-theme and persists the choice. Lives here so it
         works on every page that uses the shared Header, without a bundled module. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var KEY = 'gt-dashboard-theme';
        function currentTheme() {
          var attr = root.getAttribute('data-theme');
          if (attr === 'light' || attr === 'dark') return attr;
          return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        }
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem(KEY, next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
