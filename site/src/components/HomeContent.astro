---
import StatusHero from './StatusHero.astro';
import PlannedClosureBanner from './PlannedClosureBanner.astro';
import PortalCard from './PortalCard.astro';
import PassCard from './PassCard.astro';
import TrendChart from './TrendChart.astro';
import ForecastChart from './ForecastChart.astro';
import DiversionSection from './DiversionSection.astro';
import InfoSection from './InfoSection.astro';
import Faq from './Faq.astro';
import { type Lang } from '../lib/i18n';
import type { GotthardData, HistoryPoint } from '../lib/types';

interface Props {
  lang: Lang;
  data: GotthardData;
  history: HistoryPoint[];
}
const { lang, data, history } = Astro.props;
---

<main id="main">
  <StatusHero lang={lang} data={data} />
  <PlannedClosureBanner lang={lang} closures={data.tunnel.plannedClosures ?? []} />
  <div class="container">
    <div class="card-grid">
      <PortalCard lang={lang} side="north" portal={data.tunnel.north} />
      <PortalCard lang={lang} side="south" portal={data.tunnel.south} />
      <PassCard lang={lang} pass={data.pass} />
    </div>
  </div>
  <DiversionSection lang={lang} />
  <TrendChart lang={lang} history={history} />
  <ForecastChart lang={lang} />
  <section class="forecast container" id="forecast-section" aria-labelledby="forecast-title">
    <h2 class="forecast__title" id="forecast-title">{lang === 'de' ? 'Verkehrsvorhersage' : 'Traffic Forecast'}</h2>
    <p class="forecast__subtitle">{lang === 'de' ? 'Typisches Verkehrsaufkommen · Basierend auf Wochentag, Jahreszeit und Ferienkalender' : 'Typical congestion · Based on weekday, season, and holiday calendar'}</p>
    <div id="forecast-days" class="forecast__days" aria-live="polite"></div>
    <div class="forecast__legend">
      <span class="forecast__legend-dot" data-level="low"></span><span class="forecast__legend-label">{lang === 'de' ? 'Frei' : 'Clear'}</span>
      <span class="forecast__legend-dot" data-level="moderate"></span><span class="forecast__legend-label">{lang === 'de' ? 'Mässig' : 'Moderate'}</span>
      <span class="forecast__legend-dot" data-level="high"></span><span class="forecast__legend-label">{lang === 'de' ? 'Stau erwartet' : 'Congestion'}</span>
      <span class="forecast__legend-dot" data-level="extreme"></span><span class="forecast__legend-label">{lang === 'de' ? 'Starker Stau' : 'Heavy jam'}</span>
    </div>
    <p class="forecast__disclaimer">{lang === 'de' ? 'Prognose basiert auf historischen Mustern. Aktuelle Ereignisse können abweichen.' : 'Forecast based on historical patterns. Current events may differ.'}</p>
  </section>
  <InfoSection lang={lang} />
  <Faq lang={lang} />
</main>
<script src="../scripts/live.ts"></script>
