# Serve the Astro build on a plain Apache/PHP host (Hostpoint).
#
# The site is built with Astro `build.format: 'file'`, so pages are emitted as
# `forecasts.html`, `en.html`, `en/forecasts.html`, … while links, canonicals
# and the sitemap use clean, extensionless URLs (`/forecasts`, `/en`).
#
# SSR: EVERY page is answered by index.php (index.php?page=<path>), which reads
# the built .html as a template and fills its live markers (current status,
# today's forecast, see lib/Ssr.php) so crawlers and AI fetchers that run no
# JavaScript get current content. Real files (api/*.php, _astro/*, *.json,
# *.xml, *.txt, images) and directories are served untouched.
DirectoryIndex index.php index.html
Options -Indexes
# "/en" is also a directory (en/ holds /en/forecasts). With DirectorySlash on,
# Apache 301s /en -> /en/ before any rewrite runs, so the canonical /en URL would
# always be a redirect. Turn it off and route /en ourselves below.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Duplicate URLs -> one canonical URL (301) ──────────────────────────────
  # All of these test THE_REQUEST (the raw client request line), so they only
  # ever fire for client requests, never for our own internal rewrite to
  # index.php. index.php repeats the lang / trailing-slash checks defensively.

  # /index.html, /index.php -> /
  RewriteCond %{THE_REQUEST} \s/index\.(?:html|php)(?:\?\S*)?\s [NC]
  RewriteCond %{QUERY_STRING} ^$
  RewriteRule ^index\.(?:html|php)$ / [R=301,L]

  # Legacy language switch on a home page: /?lang=en, /?lan=en, /en?lang=en
  # -> /en; any other value (de, unknown) -> /. The query is dropped.
  RewriteCond %{THE_REQUEST} ^\S+\s/(?:en/?)?\?\S*\s
  RewriteCond %{QUERY_STRING} (?:^|&)lang?=en(?:&|$) [NC]
  RewriteRule ^(?:en/?)?$ /en? [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/(?:en/?)?\?\S*\s
  RewriteCond %{QUERY_STRING} (?:^|&)lang?= [NC]
  RewriteRule ^(?:en/?)?$ /? [R=301,L]

  # Trailing slash: /en/ -> /en, /forecasts/ -> /forecasts (trailingSlash: 'never').
  RewriteCond %{THE_REQUEST} ^\S+\s/[^?\s]+/(?:\?\S*)?\s
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)?)/$ /$1 [R=301,L]

  # Direct .html requests: /forecasts.html -> /forecasts, /en.html -> /en.
  RewriteCond %{THE_REQUEST} ^\S+\s/([a-z0-9-]+(?:/[a-z0-9-]+)?)\.html(?:\?\S*)?\s
  RewriteRule ^ /%1 [R=301,L]

  # ── Pages -> index.php (SSR) ───────────────────────────────────────────────
  # "/" (German home, index.html template).
  RewriteRule ^$ index.php [L]
  # Any extensionless path of one or two segments whose .html exists:
  # /en, /forecasts, /en/forecasts, future /it, /it/..., landing pages.
  # Checked before the real-directory passthrough below because /en is both
  # en.html and the directory en/.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)?)$ index.php?page=$1 [L,QSA]

  # Everything else that exists (files, directories) is served as is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
# Content-Security-Policy: the page loads nothing from other origins (the font is
# self-hosted, third-party data goes through api/*.php), so everything is 'self'.
#  * script-src: the few inline scripts Astro and our layout emit (theme bootstrap,
#    theme toggle, one inline module) are allowed by SHA-256 hash, not
#    'unsafe-inline'. scripts/csp-hashes.mjs computes the hashes from dist/*.html
#    after every build and replaces __CSP_SCRIPT_HASHES__ below, so editing an
#    inline script can never silently break the policy. JSON-LD blocks are data
#    (type="application/ld+json"), not executed, and need no entry.
#  * style-src 'unsafe-inline': charts and the SSR step (index.php) emit style="..."
#    attributes; style attributes cannot be hash-allowed without 'unsafe-hashes'.
#  * Report-Only first (issue #62): browsers log violations to the console but
#    block nothing. After a clean pass over all pages, comment the Report-Only
#    line out and enable the enforcing line directly below it.
# HSTS: one year, without includeSubDomains/preload until the operator has
# confirmed that every subdomain of jubr.app is HTTPS-only.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
