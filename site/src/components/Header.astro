---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  currentPage?: 'status' | 'forecasts';
}
const { lang, currentPage = 'status' } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__brand" href="/">
      <span class="site-header__mark" aria-hidden="true">GT</span>
      <span>{t(lang, 'site.title')}</span>
    </a>
    <nav class="site-nav" aria-label="Navigation">
      <a href="/" class="site-nav__link" aria-current={currentPage === 'status' ? 'page' : undefined}>
        {t(lang, 'nav.status')}
      </a>
      <a href="/forecasts" class="site-nav__link" aria-current={currentPage === 'forecasts' ? 'page' : undefined}>
        {lang === 'de' ? 'Prognosen' : 'Forecasts'}
      </a>
    </nav>
    <nav class="lang-switch" aria-label="Language">
      <a href="/?lang=de" aria-current={lang === 'de' ? 'true' : 'false'} data-lang-link="de">DE</a>
      <a href="/?lang=en" aria-current={lang === 'en' ? 'true' : 'false'} data-lang-link="en">EN</a>
    </nav>
  </div>
</header>
