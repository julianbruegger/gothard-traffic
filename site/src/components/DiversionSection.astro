---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="section diversion" id="diversion-section" aria-labelledby="diversion-title" hidden>
  <div class="section__titles">
    <h2 class="section__title" id="diversion-title">{t(lang, 'diversion.title')}</h2>
    <p class="section__sub" id="diversion-lead"></p>
  </div>
  <p class="section__sub">{t(lang, 'diversion.compare')}</p>
  <ol class="diversion__list" id="diversion-list" aria-live="polite"></ol>
  <p class="section__note">{t(lang, 'diversion.disclaimer')}</p>
</section>
