---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NerdContent from '../components/NerdContent.astro';
import { DEFAULT_LANG, t } from '../lib/i18n';

const lang = DEFAULT_LANG;
---

<Layout
  lang={lang}
  updatedIso={null}
  title={t(lang, 'meta.nerd.title')}
  description={t(lang, 'meta.nerd.description')}
  schema="webpage"
>
  <Header lang={lang} currentPage="nerd" />
  <main id="main">
    <NerdContent lang={lang} />
  </main>
  <Footer lang={lang} dataSource="ASTRA" />
</Layout>
