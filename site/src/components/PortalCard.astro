---
import { t, type Lang } from '../lib/i18n';
import { formatKm, formatMinutes, formatTrendDelta, TREND_ARROW } from '../lib/format';
import type { PortalStatus } from '../lib/types';
import type { QueueTrend } from '../lib/trend';

interface Props {
  lang: Lang;
  side: 'north' | 'south';
  portal: PortalStatus;
  trend: QueueTrend | null;
}
const { lang, side, portal, trend } = Astro.props;
const titleKey = side === 'north' ? 'portal.north' : 'portal.south';

const open = (key: string) => `<!--SSR:${side}-${key}-->`;
const close = `<!--/SSR-->`;
---

<article class="card" aria-labelledby={`${side}-title`}>
  <div class="card__header">
    <h2 class="card__title" id={`${side}-title`}>{t(lang, titleKey)}</h2>
  </div>
  <dl class="card__stats">
    <div class="card__stat-row">
      <dt class="card__stat-label">{t(lang, 'portal.queue')}</dt>
      <dd class="card__stat-value-row">
        <span class="card__stat-value" id={`${side}-queue`}
          ><Fragment set:html={open('queue')} />{formatKm(portal.queueKm, lang)}<Fragment set:html={close} /></span>
        <span
          class="trend-badge"
          id={`${side}-trend`}
          data-direction={trend?.direction ?? 'flat'}
          hidden={!trend}
        ><Fragment set:html={open('trend')} />{trend && `${TREND_ARROW[trend.direction]} ${formatTrendDelta(trend.deltaKm, lang)}`}<Fragment set:html={close} /></span>
      </dd>
    </div>
    <div class="card__stat-row">
      <dt class="card__stat-label">{t(lang, 'portal.wait')}</dt>
      <dd class="card__stat-value" id={`${side}-wait`}
        ><Fragment set:html={open('wait')} />{formatMinutes(portal.waitMinutes, lang)}<Fragment set:html={close} /></dd>
    </div>
  </dl>
  {portal.cause && (
    <p class="card__cause" id={`${side}-cause`}
      ><Fragment set:html={open('cause')} />{portal.cause}<Fragment set:html={close} /></p>
  )}
  <ul class="card__closures" id={`${side}-closures`} hidden={!portal.closures?.length}>
    {(portal.closures ?? []).map(c => <li class="card__closure-tag">{c}</li>)}
  </ul>
</article>
