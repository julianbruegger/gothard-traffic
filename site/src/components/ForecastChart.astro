---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="fchart container" aria-labelledby="fchart-title">
  <h2 class="fchart__title" id="fchart-title">{t(lang, 'fchart.title')}</h2>

  <div class="fchart__controls">
    <div class="fchart__portal-toggle" role="group" aria-label={t(lang, 'fchart.title')}>
      <button type="button" id="fchart-portal-north" class="fchart__toggle-btn" data-active="true">
        {t(lang, 'fchart.portalNorth')}
      </button>
      <button type="button" id="fchart-portal-south" class="fchart__toggle-btn">
        {t(lang, 'fchart.portalSouth')}
      </button>
    </div>
    <div class="fchart__daynav" id="fchart-daynav" role="group" aria-label={t(lang, 'fchart.dayNav')}></div>
  </div>

  <p class="fchart__subtitle" id="fchart-subtitle">{t(lang, 'fchart.subtitle')}</p>

  <div class="fchart__wrap">
    <svg
      id="forecast-chart"
      viewBox="0 0 640 260"
      role="img"
      aria-labelledby="fchart-desc"
      style="width: 100%; height: auto;"
    >
      <desc id="fchart-desc">{t(lang, 'fchart.title')}</desc>
    </svg>
    <noscript>
      <p>{t(lang, 'fchart.noscript')}</p>
    </noscript>

    <p class="fchart__note" id="fchart-note" hidden></p>

    <div class="fchart__legend" id="fchart-legend">
      <span class="fchart__legend-item">
        <span class="fchart__legend-swatch fchart__legend-swatch--dashed"></span>
        {t(lang, 'fchart.predicted')}
      </span>
      <span class="fchart__legend-item">
        <span class="fchart__legend-swatch fchart__legend-swatch--range"></span>
        {t(lang, 'fchart.range')}
      </span>
      <span class="fchart__legend-item" id="fchart-legend-actual" hidden>
        <span class="fchart__legend-swatch fchart__legend-swatch--solid"></span>
        {t(lang, 'fchart.actual')}
      </span>
      <span class="fchart__legend-historic" id="fchart-legend-historic"></span>
    </div>
  </div>
  <p class="fchart__disclaimer">{t(lang, 'forecast.disclaimer')}</p>
</section>
