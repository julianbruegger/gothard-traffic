---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (de: string, en: string) => (lang === 'de' ? de : en);

// The operator must fill these in before the page can be relied on. While they
// are null the page shows a visible placeholder instead of inventing details.
const OPERATOR: { name: string | null; contact: string | null } = { name: null, contact: null };

const TBC = L('Bedingungen des Anbieters, vom Betreiber zu bestätigen', 'Provider terms, to be confirmed by the operator');
const sources = [
  {
    name: 'ASTRA / opentransportdata.swiss',
    use: L('Verkehrslage (Stau, Sperrungen) am Gotthard', 'Traffic situation (queues, closures) at the Gotthard'),
    terms: L('Open-Data-Nutzungsbedingungen von opentransportdata.swiss', 'opentransportdata.swiss open-data terms of use'),
  },
  {
    name: 'Open-Meteo',
    use: L('Wetterdaten für die Wetter-Auswertungen', 'Weather data for the weather analyses'),
    terms: L('Daten unter CC BY 4.0, Quellenangabe erforderlich', 'Data under CC BY 4.0, attribution required'),
  },
  {
    name: 'OpenHolidays API (openholidaysapi.org)',
    use: L('Schulferien (CH, DE, NL) für Nerd Mode', 'School holidays (CH, DE, NL) for Nerd Mode'),
    terms: TBC,
  },
  {
    name: 'transport.opendata.ch',
    use: L('Nächster Zug Göschenen–Airolo (Nerd Mode)', 'Next train Göschenen–Airolo (Nerd Mode)'),
    terms: TBC,
  },
  {
    name: 'alpen-paesse.ch',
    use: L('Status des Gotthardpasses', 'Gotthard Pass status'),
    terms: TBC,
  },
  {
    name: 'TCS',
    use: L('Historische Staumeldungen als Grundlage von Prognose und Statistik', 'Historic queue reports underlying the forecast and statistics'),
    terms: TBC,
  },
];
---

<main id="main" class="container page privacy">
  <div class="page-head">
    <h1>{L('Datenschutz und Impressum', 'Privacy notice and imprint')}</h1>
    <p>{L(
      'Kurz gesagt: Diese Seite setzt keine Cookies, verwendet kein Tracking und lädt nichts von Drittanbietern in Ihren Browser.',
      'In short: this site sets no cookies, uses no tracking and loads nothing from third parties into your browser.',
    )}</p>
  </div>

  <div class="callout" role="note">
    <span>{L(
      'Entwurf: Dieser Text beschreibt die technische Funktionsweise der Seite. Er wurde nicht rechtlich geprüft und muss vom Betreiber vor der Verwendung geprüft und mit den fehlenden Angaben ergänzt werden.',
      'Draft: this text describes how the site works technically. It has not been legally reviewed; the operator must review it and add the missing details before relying on it.',
    )}</span>
  </div>

  <section class="section" aria-labelledby="pv-operator">
    <h2 class="section__title" id="pv-operator">{L('Betreiber und Kontakt', 'Operator and contact')}</h2>
    <p>{L(
      'Unabhängiges, privates Projekt ohne Verbindung zum Bundesamt für Strassen (ASTRA) oder anderen Behörden.',
      'Independent, private project with no connection to the Federal Roads Office (ASTRA) or any other authority.',
    )}</p>
    <p>
      {L('Betreiber', 'Operator')}: {OPERATOR.name ?? L('[Name des Betreibers: noch einzutragen]', '[operator name: still to be filled in]')}<br />
      {L('Kontakt', 'Contact')}: {OPERATOR.contact ?? L('[Kontaktadresse: noch einzutragen]', '[contact address: still to be filled in]')}
    </p>
  </section>

  <section class="section" aria-labelledby="pv-processed">
    <h2 class="section__title" id="pv-processed">{L('Welche Daten verarbeitet werden', 'What is processed')}</h2>
    <h3>{L('Server-Logdateien', 'Server log files')}</h3>
    <p>{L(
      'Beim Aufruf einer Seite übermittelt Ihr Browser technisch notwendige Angaben an den Webserver (Hostpoint): IP-Adresse, Zeitpunkt, aufgerufene Adresse, Statuscode, Referrer und Browserkennung. Der Webhoster kann diese Angaben für Betrieb und Sicherheit protokollieren. Die Anwendung dieser Seite speichert keine IP-Adressen von Besucherinnen und Besuchern in ihrer Datenbank. Aufbewahrungsdauer der Logdateien: [vom Betreiber anhand der Angaben des Hosters zu ergänzen].',
      'When you open a page, your browser sends technically necessary information to the web server (Hostpoint): IP address, time, requested address, status code, referrer and browser identifier. The web host may log this for operation and security. This site\'s application does not store visitors\' IP addresses in its database. Retention period of the log files: [to be added by the operator from the host\'s documentation].',
    )}</p>
    <h3>{L('Keine Cookies, kein Tracking', 'No cookies, no tracking')}</h3>
    <p>{L(
      'Es werden keine Cookies gesetzt und keine Analyse-, Werbe- oder Social-Media-Dienste eingebunden.',
      'No cookies are set and no analytics, advertising or social-media services are embedded.',
    )}</p>
    <h3>{L('Lokaler Speicher im Browser', 'Local storage in your browser')}</h3>
    <p>{L(
      'Wenn Sie zwischen hellem und dunklem Design wechseln, speichert Ihr Browser diese Wahl unter dem Schlüssel gt-dashboard-theme im lokalen Speicher (localStorage). Der Wert wird nicht an den Server gesendet und kann jederzeit über die Browser-Einstellungen gelöscht werden.',
      'If you switch between light and dark theme, your browser stores that choice under the key gt-dashboard-theme in local storage (localStorage). The value is not sent to the server and can be deleted at any time in your browser settings.',
    )}</p>
    <h3>{L('Schrift', 'Font')}</h3>
    <p>{L(
      'Die Schrift Roboto Flex (SIL Open Font License 1.1) wird von dieser Seite selbst ausgeliefert. Es erfolgt keine Verbindung zu Google Fonts.',
      'The Roboto Flex font (SIL Open Font License 1.1) is served by this site itself. No connection to Google Fonts is made.',
    )}</p>
  </section>

  <section class="section" aria-labelledby="pv-third">
    <h2 class="section__title" id="pv-third">{L('Anfragen an Dritte', 'Requests to third parties')}</h2>
    <p>{L(
      'Ihr Browser kontaktiert ausschliesslich diese Seite (gotthard.jubr.app). Verkehrs-, Wetter-, Ferien- und Zugdaten holt der Server dieser Seite selbst ab (zeitgesteuert oder über zwischengespeicherte Schnittstellen unter /api/). Die Drittanbieter sehen dabei die Adresse des Servers, nicht Ihre IP-Adresse.',
      'Your browser contacts only this site (gotthard.jubr.app). Traffic, weather, holiday and train data are fetched by this site\'s server itself (on a schedule or through cached endpoints under /api/). The third-party providers see the server\'s address, not your IP address.',
    )}</p>
  </section>

  <section class="section" aria-labelledby="pv-sources">
    <h2 class="section__title" id="pv-sources">{L('Datenquellen und Lizenzen', 'Data sources and licences')}</h2>
    <ul class="privacy-list">
      {sources.map((s) => (
        <li><strong>{s.name}</strong>: {s.use}. <span class="section__note">{s.terms}.</span></li>
      ))}
    </ul>
    <p class="section__note">{L(
      'Die Prognose ist ein Modell und eine Schätzung, keine Messung.',
      'The forecast is a model and an estimate, not a measurement.',
    )}</p>
  </section>

  <section class="section" aria-labelledby="pv-api">
    <h2 class="section__title" id="pv-api">{L('Daten dieser Seite weiterverwenden', 'Reusing this site\'s data')}</h2>
    <p>{L(
      'Die JSON-Schnittstellen unter /api/ sind öffentlich und schreibgeschützt. Sie dürfen mit Quellenangabe und Link auf https://gotthard.jubr.app/ weiterverwendet werden. Bitte Antworten zwischenspeichern und nicht häufiger als etwa einmal pro Minute abfragen, die Daten ändern sich ungefähr alle 3 Minuten. Es gibt keine Verfügbarkeits- oder Richtigkeitsgarantie; für sicherheitsrelevante Entscheidungen gelten die offiziellen Kanäle.',
      'The JSON endpoints under /api/ are public and read-only. They may be reused with attribution and a link to https://gotthard.jubr.app/. Please cache responses and poll no more than about once a minute; the data changes roughly every 3 minutes. There is no guarantee of availability or accuracy; for safety-critical decisions use the official channels.',
    )}</p>
  </section>

  <section class="section" aria-labelledby="pv-rights">
    <h2 class="section__title" id="pv-rights">{L('Fragen zu Ihren Daten', 'Questions about your data')}</h2>
    <p>{L(
      'Für Auskunfts- oder Löschwünsche und andere Fragen zum Datenschutz wenden Sie sich an die oben genannte Kontaktadresse.',
      'For access or deletion requests and other privacy questions, contact the address given above.',
    )}</p>
    <p class="section__note">{L('Stand: November 2026', 'Last updated: November 2026')}</p>
  </section>
</main>
