---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeContent from '../components/HomeContent.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LANG } from '../lib/i18n';
import { loadHomeData } from '../lib/load-data';

const lang = DEFAULT_LANG;
const { data, history } = loadHomeData();
---

<Layout lang={lang} updatedIso={data.updated}>
  <Header lang={lang} />
  <HomeContent lang={lang} data={data} history={history} />
  <Footer lang={lang} dataSource={data.source} />
</Layout>
