---
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { t, type Lang } from '../lib/i18n';
import { buildYearlyChart, type DayPoint } from '../lib/yearly-forecast';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const histPath = join(process.cwd(), 'public/data/yearly-traffic.json');
let hist: Record<string, DayPoint[]> | null = null;
if (existsSync(histPath)) {
  try {
    hist = (JSON.parse(readFileSync(histPath, 'utf8')) as { years: Record<string, DayPoint[]> }).years;
  } catch { /* fall back to model */ }
}

const chart = buildYearlyChart(hist, lang);
---

<section class="yearly-forecast container" aria-labelledby="yearly-forecast-title">
  <h2 class="yearly-forecast__title" id="yearly-forecast-title">{t(lang, 'yearly.title')}</h2>
  <p class="yearly-forecast__subtitle">{t(lang, 'yearly.subtitle')}</p>

  <div class="yearly-forecast__chart-wrap">
    <svg
      viewBox={`0 0 ${chart.svgWidth} ${chart.svgHeight}`}
      role="img"
      aria-label={t(lang, 'yearly.title')}
      preserveAspectRatio="xMidYMid meet"
      style="width: 100%; height: auto; min-width: 360px;"
    >
      <!-- Y-axis unit label (rotated) -->
      <text
        x="8"
        y={chart.svgHeight / 2}
        text-anchor="middle"
        font-size="10"
        fill="var(--color-text-muted)"
        font-family="var(--font-sans)"
        transform={`rotate(-90, 8, ${chart.svgHeight / 2})`}
      >{t(lang, 'yearly.yAxisLabel')}</text>

      <!-- Horizontal grid lines + Y-axis labels -->
      {chart.gridLines.map(gl => (
        <>
          <line
            x1={gl.x1} y1={gl.y} x2={gl.x2} y2={gl.y}
            stroke="var(--color-border)"
            stroke-width="1"
            stroke-dasharray="4 3"
          />
          <text
            x={gl.labelX}
            y={gl.labelY}
            text-anchor="end"
            font-size="11"
            fill="var(--color-text-muted)"
            font-family="var(--font-sans)"
          >{gl.label}</text>
        </>
      ))}

      <!-- Min-max shaded band (historical range 2023–2025) -->
      <path
        d={chart.bandPath}
        fill="rgba(163, 230, 53, 0.12)"
        stroke="none"
      />

      <!-- Year lines (2026 rendered last / on top) -->
      {chart.lines.map(line => (
        <path
          d={line.path}
          fill="none"
          stroke={line.color}
          stroke-width="2.5"
          stroke-dasharray={line.strokeDasharray ?? undefined}
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      ))}

      <!-- X-axis ticks: month labels -->
      {chart.xTicks.map(tick => (
        <text
          x={tick.x}
          y={tick.y}
          text-anchor="middle"
          font-size="10"
          fill="var(--color-text-muted)"
          font-family="var(--font-sans)"
        >{tick.label}</text>
      ))}
    </svg>

    <!-- Legend -->
    <div class="yearly-forecast__legend">
      {chart.lines.map(line => (
        <span class="yearly-forecast__legend-item">
          <svg width="24" height="6" aria-hidden="true" class="yearly-forecast__legend-swatch">
            <line
              x1="0" y1="3" x2="24" y2="3"
              stroke={line.color}
              stroke-width="2.5"
              stroke-dasharray={line.strokeDasharray ?? undefined}
            />
          </svg>
          <span>
            {line.year}
            {line.strokeDasharray ? ` (${t(lang, 'yearly.forecastLabel')})` : ''}
          </span>
        </span>
      ))}
    </div>
  </div>

  <p class="yearly-forecast__disclaimer">{t(lang, 'yearly.disclaimer')}</p>
</section>
