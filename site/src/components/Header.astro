---
import { t, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  currentPage?: 'status' | 'forecasts' | 'statistics' | 'nerd' | 'privacy';
}
const { lang, currentPage = 'status' } = Astro.props;

// Language-neutral path of the current page (strip any /en prefix), used to
// build in-language nav links and the DE/EN switch that point at the real
// per-language URLs (German at the root, English under /en) instead of a
// ?lang= query param that served duplicate content.
const rawPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const path = rawPath !== '/' ? rawPath.replace(/\/$/, '') : '/';
const logical = path === '/en' ? '/' : path.startsWith('/en/') ? path.slice(3) : path;

const prefix = (l: Lang) => (l === 'de' ? '' : '/en');
const home = (l: Lang) => prefix(l) || '/';
const deHref = logical === '/' ? '/' : logical;
const enHref = logical === '/' ? '/en' : '/en' + logical;

const links = [
  { key: 'status', href: home(lang), label: t(lang, 'nav.live'), icon: 'live' },
  { key: 'forecasts', href: `${prefix(lang)}/forecasts`, label: t(lang, 'nav.forecast'), icon: 'calendar' },
  { key: 'statistics', href: `${prefix(lang)}/statistics`, label: t(lang, 'nav.stats'), icon: 'bar_chart' },
  { key: 'nerd', href: `${prefix(lang)}/nerd`, label: t(lang, 'nav.nerd'), icon: 'table' },
] as const;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__brand" href={home(lang)}>
      <span class="site-header__mark"><Icon name="terrain" size={24} /></span>
      <span>{t(lang, 'site.title')}</span>
    </a>
    <nav class="site-nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      {links.map((l) => (
        <a href={l.href} class="site-nav__link" aria-current={currentPage === l.key ? 'page' : undefined}>
          <Icon name={l.icon} size={20} />{l.label}
        </a>
      ))}
    </nav>
    <div class="header__actions">
      <nav class="lang-switch" aria-label={lang === 'de' ? 'Sprache' : 'Language'}>
        <a href={deHref} lang="de" aria-current={lang === 'de' ? 'true' : 'false'} data-lang-link="de">DE</a>
        <a href={enHref} lang="en" aria-current={lang === 'en' ? 'true' : 'false'} data-lang-link="en">EN</a>
      </nav>
      <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label={t(lang, 'theme.toggle')}>
        <Icon name="moon" size={22} class="icon theme-toggle__moon" />
        <Icon name="sun" size={22} class="icon theme-toggle__sun" />
      </button>
    </div>
  </div>
</header>
