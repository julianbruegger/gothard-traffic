---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyContent from '../components/PrivacyContent.astro';

import { t } from '../lib/i18n';

const lang = 'de' as const;
---

<Layout
  lang={lang}
  updatedIso={null}
  title={t(lang, 'meta.privacy.title')}
  description={t(lang, 'meta.privacy.description')}
  schema="webpage"
>
  <Header lang={lang} currentPage="privacy" />
  <PrivacyContent lang={lang} />
  <Footer lang={lang} dataSource="ASTRA / opentransportdata.swiss" />
</Layout>
