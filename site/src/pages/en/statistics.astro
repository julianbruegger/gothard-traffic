---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StatsContent from '../../components/StatsContent.astro';

import { t } from '../../lib/i18n';

const lang = 'en' as const;
---

<Layout
  lang={lang}
  updatedIso={null}
  title={t(lang, 'meta.statistics.title')}
  description={t(lang, 'meta.statistics.description')}
  schema="webpage"
>
  <Header lang={lang} currentPage="statistics" />
  <StatsContent lang={lang} />
  <Footer lang={lang} dataSource="TCS traffic reports" />
</Layout>
